                const baseTemp = 33 + Math.sin(i / 30) * 2;\
                const baseHum = 62 + Math.cos(i / 40) * 8;\
                const baseCO2 = 800 + Math.sin(i / 50) * 400;\
                const baseNH3 = 30 + Math.abs(Math.sin(i / 60)) * 60;\
                \
                historyData.push(\{\
                    time: time,\
                    temp: baseTemp + (Math.random() - 0.5) * 0.6,\
                    hum: Math.max(30, Math.min(100, baseHum + (Math.random() - 0.5) * 4)),\
                    co2: Math.round(baseCO2 + (Math.random() - 0.5) * 100),\
                    nh3: Math.round(baseNH3 + (Math.random() - 0.5) * 20),\
                    fan: Math.round(80 + Math.sin(i / 45) * 50),\
