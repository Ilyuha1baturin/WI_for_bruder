            if (!confirm('\uc0\u1057 \u1073 \u1088 \u1086 \u1089 \u1080 \u1090 \u1100  \u1073 \u1072 \u1079 \u1086 \u1074 \u1091 \u1102  \u1083 \u1080 \u1085 \u1080 \u1102  NH\u8323 ? \u1044 \u1072 \u1090 \u1095 \u1080 \u1082  \u1076 \u1086 \u1083 \u1078 \u1077 \u1085  \u1073 \u1099 \u1090 \u1100  \u1085 \u1072  \u1089 \u1074 \u1077 \u1078 \u1077 \u1084  \u1074 \u1086 \u1079 \u1076 \u1091 \u1093 \u1077 .')) return;\
            if (isDemoMode) \{\
                demoState.nh3 = 0;\
                alert('
\f1 \uc0\u55356 \u57262 
\f0  \uc0\u1044 \u1077 \u1084 \u1086 : \u1073 \u1072 \u1079 \u1086 \u1074 \u1072 \u1103  \u1083 \u1080 \u1085 \u1080 \u1103  NH\u8323  \u1089 \u1073 \u1088 \u1086 \u1096 \u1077 \u1085 \u1072 ');\
                updateUI(demoState);\
            \} else \{\
                sendCmd('calNH3', true);\
            \}\
        \}\
\
        // ==========================================\
        // \uc0\u1043 \u1056 \u1040 \u1060 \u1048 \u1050 \u1048 \
        // ==========================================\
        function switchTab(tab) \{\
            currentTab = tab;\
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\
            event.target.classList.add('active');\
            updateChart();\
        \}\
\
        function updateChart() \{\
            if (historyData.length === 0) return;\
            \
            const ctx = document.getElementById('mainChart').getContext('2d');\
            const labels = historyData.map(d => d.time);\
\
            let datasets, legendHTML;\
\
            if (currentTab === 'temp') \{\
                datasets = [\
                    \{\
                        label: '\uc0\u1058 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1072  \u1092 \u1072 \u1082 \u1090 , \'b0C',\
                        data: historyData.map(d => d.temp),\
                        borderColor: '#10b981',\
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',\
                        fill: true,\
                        tension: 0.4,\
                        pointRadius: 2\
                    \},\
                    \{\
                        label: '\uc0\u1058 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1072  \u1094 \u1077 \u1083 \u1100 , \'b0C',\
                        data: historyData.map(() => parseFloat(document.getElementById('targetTempDisplay').textContent) || 33),\
                        borderColor: '#f59e0b',\
                        borderDash: [5, 5],\
                        pointRadius: 0,\
                        tension: 0\
                    \}\
                ];\
                legendHTML = `\
                    <div class="legend-item"><div class="legend-dot" style="background:#10b981"></div><span>\uc0\u1060 \u1072 \u1082 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1072 \u1103 </span></div>\
                    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div><span>\uc0\u1062 \u1077 \u1083 \u1077 \u1074 \u1072 \u1103 </span></div>\
                `;\
            \} else if (currentTab === 'hum') \{\
                datasets = [\
                    \{\
                        label: '\uc0\u1042 \u1083 \u1072 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100  \u1092 \u1072 \u1082 \u1090 , %',\
                        data: historyData.map(d => d.hum),\
                        borderColor: '#3b82f6',\
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',\
                        fill: true,\
                        tension: 0.4,\
                        pointRadius: 2\
                    \},\
                    \{\
                        label: '\uc0\u1042 \u1083 \u1072 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100  \u1094 \u1077 \u1083 \u1100 , %',\
                        data: historyData.map(() => parseFloat(document.getElementById('targetHumDisplay').textContent) || 65),\
                        borderColor: '#f59e0b',\
                        borderDash: [5, 5],\
                        pointRadius: 0,\
                        tension: 0\
                    \}\
                ];\
                legendHTML = `\
                    <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div><span>\uc0\u1060 \u1072 \u1082 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1072 \u1103 </span></div>\
                    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div><span>\uc0\u1062 \u1077 \u1083 \u1077 \u1074 \u1072 \u1103 </span></div>\
                `;\
            \} else \{\
                datasets = [\
                    \{\
                        label: 'CO\uc0\u8322 , ppm',\
                        data: historyData.map(d => d.co2),\
                        borderColor: '#ef4444',\
                        backgroundColor: 'rgba(239, 68, 68, 0.05)',\
                        fill: true,\
                        tension: 0.4,\
                        pointRadius: 2,\
                        yAxisID: 'y'\
                    \},\
                    \{\
                        label: 'NH\uc0\u8323 ',\
                        data: historyData.map(d => d.nh3),\
                        borderColor: '#f59e0b',\
                        tension: 0.4,\
                        pointRadius: 2,\
                        yAxisID: 'y'\
                    \},\
                    \{\
                        label: 'IAQ, %',\
                        data: historyData.map(d => d.iaq),\
                        borderColor: '#8b5cf6',\
                        borderDash: [3, 3],\
                        pointRadius: 1,\
                        yAxisID: 'y1'\
                    \}\
                ];\
                legendHTML = `\
                    <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div><span>CO\uc0\u8322 </span></div>\
                    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div><span>NH\uc0\u8323 </span></div>\
                    <div class="legend-item"><div class="legend-dot" style="background:#8b5cf6"></div><span>IAQ</span></div>\
                `;\
            \}\
\
            document.getElementById('chartLegend').innerHTML = legendHTML;\
\
            if (chartInstance) chartInstance.destroy();\
\
            const scales = currentTab === 'gas' ? \{\
                y: \{\
                    type: 'linear',\
                    display: true,\
                    position: 'left',\
                    grid: \{ color: 'rgba(255,255,255,0.05)' \},\
                    ticks: \{ color: '#94a3b8' \}\
                \},\
                y1: \{\
                    type: 'linear',\
                    display: true,\
                    position: 'right',\
                    grid: \{ drawOnChartArea: false \},\
                    ticks: \{ color: '#8b5cf6', callback: v => v + '%' \},\
                    min: 0, max: 100\
                \},\
                x: \{\
                    grid: \{ color: 'rgba(255,255,255,0.05)' \},\
                    ticks: \{ color: '#94a3b8', maxTicksLimit: 8 \}\
                \}\
            \} : \{\
                y: \{\
                    grid: \{ color: 'rgba(255,255,255,0.05)' \},\
                    ticks: \{ color: '#94a3b8' \}\
                \},\
                x: \{\
                    grid: \{ color: 'rgba(255,255,255,0.05)' \},\
                    ticks: \{ color: '#94a3b8', maxTicksLimit: 8 \}\
                \}\
            \};\
\
            chartInstance = new Chart(ctx, \{\
                type: 'line',\
                data: \{ labels, datasets \},\
                options: \{\
                    responsive: true,\
                    maintainAspectRatio: false,\
                    interaction: \{ mode: 'index', intersect: false \},\
                    plugins: \{\
                        legend: \{ display: false \},\
                        tooltip: \{\
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',\
                            titleColor: '#f1f5f9',\
                            bodyColor: '#cbd5e1',\
                            borderColor: 'rgba(148, 163, 184, 0.2)',\
                            borderWidth: 1,\
                            padding: 12\
                        \}\
                    \},\
                    scales\
                \}\
            \});\
        \}\
\
        // ==========================================\
        // \uc0\u1054 \u1041 \u1053 \u1054 \u1042 \u1051 \u1045 \u1053 \u1048 \u1045  \u1048 \u1053 \u1058 \u1045 \u1056 \u1060 \u1045 \u1049 \u1057 \u1040 \
        // ==========================================\
        function updateUI(d) \{\
            // \uc0\u1058 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1072 \
            const isTempErr = d.t < -100;\
            const tempEl = document.getElementById('tempDisplay');\
            if (isTempErr) \{\
                tempEl.textContent = 'ERR';\
                tempEl.className = 'big-value error';\
                document.getElementById('tempBar').style.width = '0%';\
            \} else \{\
                tempEl.textContent = d.t.toFixed(1) + '\'b0';\
                tempEl.className = 'big-value ' + (d.t > 38 || d.t < 20 ? 'error' : Math.abs(d.t - d.tt) > 2 ? 'warning' : 'normal');\
                const barWidth = Math.min(Math.max((d.t / 45) * 100, 0), 100);\
                document.getElementById('tempBar').style.width = barWidth + '%';\
                document.getElementById('tempBar').style.background = d.t > 38 || d.t < 20 ? 'var(--danger)' : 'var(--accent)';\
            \}\
            document.getElementById('targetTempDisplay').textContent = d.tt.toFixed(1);\
\
            // \uc0\u1042 \u1083 \u1072 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100 \
            const isHumErr = d.h < 0;\
            const humEl = document.getElementById('humDisplay');\
            if (isHumErr) \{\
                humEl.textContent = 'ERR';\
                humEl.className = 'big-value small error';\
                document.getElementById('humBar').style.width = '0%';\
            \} else \{\
                humEl.textContent = d.h.toFixed(0) + '%';\
                humEl.className = 'big-value small ' + (d.h > d.th + 10 ? 'warning' : 'info');\
                document.getElementById('humBar').style.width = Math.min(d.h, 100) + '%';\
            \}\
            document.getElementById('targetHumDisplay').textContent = d.th.toFixed(0);\
\
            // IAQ\
            const iaq = d.iaq || 0;\
            document.getElementById('iaqDisplay').textContent = iaq;\
            document.getElementById('iaqRing').style.setProperty('--iaq-deg', (iaq / 100 * 360) + 'deg');\
            const iaqLabel = document.getElementById('iaqLabel');\
            if (iaq < 20) \{ iaqLabel.textContent = '
\f1 \uc0\u9989 
\f0  \uc0\u1054 \u1090 \u1083 \u1080 \u1095 \u1085 \u1086 '; iaqLabel.style.color = 'var(--accent)'; \}\
            else if (iaq < 40) \{ iaqLabel.textContent = '
\f1 \uc0\u55357 \u57313 
\f0  \uc0\u1061 \u1086 \u1088 \u1086 \u1096 \u1086 '; iaqLabel.style.color = '#eab308'; \}\
            else if (iaq < 60) \{ iaqLabel.textContent = '
\f1 \uc0\u55357 \u57312 
\f0  \uc0\u1059 \u1076 \u1086 \u1074 \u1083 \u1077 \u1090 \u1074 \u1086 \u1088 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086 '; iaqLabel.style.color = 'var(--warning)'; \}\
            else if (iaq < 80) \{ iaqLabel.textContent = '
\f1 \uc0\u55357 \u56628 
\f0  \uc0\u1055 \u1083 \u1086 \u1093 \u1086 '; iaqLabel.style.color = '#f97316'; \}\
            else \{ iaqLabel.textContent = '
\f1 \uc0\u9760 \u65039 
\f0  \uc0\u1054 \u1087 \u1072 \u1089 \u1085 \u1086 '; iaqLabel.style.color = 'var(--danger)'; \}\
\
            // \uc0\u1043 \u1072 \u1079 \u1099 \
            const co2 = d.co2 || 0;\
            document.getElementById('co2Display').textContent = co2 + ' ppm';\
            const co2Bar = document.getElementById('co2Bar');\
            co2Bar.style.width = Math.min(co2 / 2000 * 100, 100) + '%';\
            co2Bar.style.background = co2 > 1500 ? 'var(--danger)' : co2 > 1000 ? 'var(--warning)' : 'var(--accent)';\
\
            const nh3 = d.nh3 || 0;\
            const nh3El = document.getElementById('nh3Display');\
            const nh3Bar = document.getElementById('nh3Bar');\
            nh3Bar.style.width = Math.min(nh3 / 800 * 100, 100) + '%';\
            if (nh3 > 500) \{\
                nh3El.innerHTML = '
\f1 \uc0\u9760 \u65039 
\f0  \uc0\u1050 \u1056 \u1048 \u1058 \u1048 \u1063 \u1053 \u1054  <span style="color:var(--danger);font-size:0.85rem;">(' + nh3 + ')</span>';\
                nh3El.style.color = 'var(--danger)';\
                nh3Bar.style.background = 'var(--danger)';\
            \} else if (nh3 > 200) \{\
                nh3El.innerHTML = '
\f1 \uc0\u9888 \u65039 
\f0  \uc0\u1055 \u1086 \u1074 \u1099 \u1096 \u1077 \u1085  <span style="color:var(--warning);font-size:0.85rem;">(' + nh3 + ')</span>';\
                nh3El.style.color = 'var(--warning)';\
                nh3Bar.style.background = 'var(--warning)';\
            \} else \{\
                nh3El.innerHTML = '
\f1 \uc0\u9989 
\f0  \uc0\u1053 \u1086 \u1088 \u1084 \u1072  <span style="color:var(--text-muted);font-size:0.85rem;">(' + nh3 + ')</span>';\
                nh3El.style.color = 'var(--accent)';\
                nh3Bar.style.background = 'var(--accent)';\
            \}\
\
            // \uc0\u1042 \u1077 \u1085 \u1090 \u1080 \u1083 \u1103 \u1090 \u1086 \u1088 \
            const fanPct = Math.round((d.fan / 255) * 100);\
            document.getElementById('fanDisplay').textContent = fanPct + '%';\
            document.getElementById('fanBar').style.width = fanPct + '%';\
            document.getElementById('fanLimitDisplay').textContent = d.fanLimit || 50;\
\
            // \uc0\u1041 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 \u1089 \u1090 \u1100 \
            const waterEl = document.getElementById('waterDisplay');\
            waterEl.textContent = d.w ? '
\f1 \uc0\u9989 
\f0  \uc0\u1045 \u1089 \u1090 \u1100 ' : '
\f1 \uc0\u10060 
\f0  \uc0\u1053 \u1045 \u1058 ';\
            waterEl.style.color = d.w ? 'var(--accent)' : 'var(--danger)';\
\
            const doorEl = document.getElementById('doorDisplay');\
            const doorsOk = d.lid && d.door;\
            doorEl.textContent = doorsOk ? '
\f1 \uc0\u55357 \u56594 
\f0  \uc0\u1047 \u1072 \u1082 \u1088 \u1099 \u1090 \u1099 ' : '
\f1 \uc0\u55357 \u56595 
\f0  \uc0\u1054 \u1058 \u1050 \u1056 \u1067 \u1058 \u1067 !';\
            doorEl.style.color = doorsOk ? 'var(--accent)' : 'var(--danger)';\
\
            const panicEl = document.getElementById('panicDisplay');\
            panicEl.textContent = d.p ? '
\f1 \uc0\u55357 \u56586 
\f0  \uc0\u1050 \u1056 \u1048 \u1050 !' : '
\f1 \uc0\u55357 \u56583 
\f0  \uc0\u1058 \u1080 \u1096 \u1080 \u1085 \u1072 ';\
            panicEl.style.color = d.p ? 'var(--danger)' : 'var(--accent)';\
\
            document.getElementById('luxDisplay').textContent = d.l + ' \uc0\u1083 \u1082 ';\
\
            // \uc0\u1040 \u1074 \u1072 \u1088 \u1080 \u1103 \
            const alarmBanner = document.getElementById('alarmBanner');\
            if (d.a) \{\
                alarmBanner.classList.add('visible');\
                let msg = '\uc0\u1040 \u1042 \u1040 \u1056 \u1048 \u1071  \u1042  \u1057 \u1048 \u1057 \u1058 \u1045 \u1052 \u1045 ';\
                if (!d.w) msg = '
\f1 \uc0\u10060 
\f0  \uc0\u1053 \u1045 \u1058  \u1042 \u1054 \u1044 \u1067 ';\
                else if (!d.lid || !d.door) msg = '
\f1 \uc0\u55357 \u56595 
\f0  \uc0\u1054 \u1058 \u1050 \u1056 \u1067 \u1058 \u1040  \u1050 \u1056 \u1067 \u1064 \u1050 \u1040 /\u1044 \u1042 \u1045 \u1056 \u1068 ';\
                else if (d.p) msg = '
\f1 \uc0\u55357 \u56586 
\f0  \uc0\u1055 \u1040 \u1053 \u1048 \u1050 \u1040  \u1062 \u1067 \u1055 \u1051 \u1071 \u1058 ';\
                else if (isTempErr) msg = '
\f1 \uc0\u55356 \u57121 
\f0  \uc0\u1054 \u1058 \u1050 \u1040 \u1047  \u1044 \u1040 \u1058 \u1063 \u1048 \u1050 \u1040  \u1058 \u1045 \u1052 \u1055 \u1045 \u1056 \u1040 \u1058 \u1059 \u1056 \u1067 ';\
                else if (d.t >= 38) msg = '
\f1 \uc0\u55356 \u57121 
\f0  \uc0\u1055 \u1045 \u1056 \u1045 \u1043 \u1056 \u1045 \u1042 : ' + d.t.toFixed(1) + '\'b0C';\
                else if (d.t <= 20) msg = '
\f1 \uc0\u55356 \u57121 
\f0  \uc0\u1055 \u1045 \u1056 \u1045 \u1054 \u1061 \u1051 \u1040 \u1046 \u1044 \u1045 \u1053 \u1048 \u1045 : ' + d.t.toFixed(1) + '\'b0C';\
                else if (co2 > 1500) msg = '
\f1 \uc0\u55356 \u57132 
\f0  \uc0\u1050 \u1056 \u1048 \u1058 \u1048 \u1063 \u1045 \u1057 \u1050 \u1048 \u1049  CO\u8322 : ' + co2;\
                else if (nh3 > 500) msg = '
\f1 \uc0\u9760 \u65039 
\f0  \uc0\u1040 \u1052 \u1052 \u1048 \u1040 \u1050 : ' + nh3;\
                document.getElementById('alarmText').textContent = msg;\
            \} else \{\
                alarmBanner.classList.remove('visible');\
            \}\
\
            // \uc0\u1056 \u1077 \u1078 \u1080 \u1084  \u1080  \u1088 \u1077 \u1083 \u1077 \
            const isAuto = d.mode;\
            document.getElementById('modeBadge').textContent = isAuto ? '\uc0\u1040 \u1042 \u1058 \u1054 ' : '\u1056 \u1059 \u1063 \u1053 \u1054 \u1049 ';\
            document.getElementById('modeBadge').style.background = isAuto ? 'var(--accent-dim)' : 'var(--warning-dim)';\
            document.getElementById('modeBadge').style.color = isAuto ? 'var(--accent)' : 'var(--warning)';\
            document.getElementById('modeText').textContent = isAuto ? '\uc0\u1040 \u1042 \u1058 \u1054 \u1052 \u1040 \u1058 \u1048 \u1063 \u1045 \u1057 \u1050 \u1048 \u1049 ' : '\u1056 \u1059 \u1063 \u1053 \u1054 \u1049 ';\
            document.getElementById('modeSwitch').checked = isAuto;\
\
            document.getElementById('tempSlider').disabled = isAuto;\
            document.getElementById('humSlider').disabled = isAuto;\
\
            for (let i = 0; i < 5; i++) \{\
                const on = d.r[i];\
                const led = document.getElementById('led' + i);\
                const btn = document.getElementById('btnRel' + i);\
\
                if (on) \{\
                    led.classList.add('on');\
                    if (i === 4) led.classList.add('cool');\
                \} else \{\
                    led.classList.remove('on', 'cool');\
                \}\
\
                if (btn) \{\
                    if (on) btn.classList.add('active');\
                    else btn.classList.remove('active');\
                    btn.disabled = isAuto;\
                    if (i < 4) \{\
                        btn.innerHTML = isAuto ? '
\f1 \uc0\u55357 \u56594 
\f0  ' + ['L1','L2','L3','L4'][i] : '
\f1 \uc0\u55357 \u56613 
\f0  ' + ['L1','L2','L3','L4'][i];\
                    \} else \{\
                        btn.innerHTML = isAuto ? '
\f1 \uc0\u55357 \u56594 
\f0  \uc0\u1057 \u1074 \u1077 \u1090 ' : '
\f1 \uc0\u55357 \u56481 
\f0  \uc0\u1057 \u1074 \u1077 \u1090 ';\
                    \}\
                \}\
            \}\
\
            document.getElementById('manualControls').style.display = isAuto ? 'none' : 'block';\
            document.getElementById('autoBlock').style.display = isAuto ? 'block' : 'none';\
\
            const breed = d.breed || 0;\
            document.getElementById('breedSelect').value = breed;\
            document.getElementById('breedBadge').textContent = breedNames[breed];\
\
            const age = d.age || 1;\
            const offset = d.ageOffset || 0;\
            document.getElementById('ageDisplay').textContent = age;\
            document.getElementById('ageOffsetDisplay').textContent = (offset >= 0 ? '+' : '') + offset;\
            document.getElementById('ageBadge').textContent = '\uc0\u1044 \u1077 \u1085 \u1100  ' + age;\
\
            if (document.activeElement !== document.getElementById('tempSlider') && !isAuto) \{\
                document.getElementById('tempSlider').value = d.tt;\
                document.getElementById('sliderTempVal').textContent = d.tt.toFixed(1);\
            \}\
            if (document.activeElement !== document.getElementById('humSlider') && !isAuto) \{\
                document.getElementById('humSlider').value = d.th;\
                document.getElementById('sliderHumVal').textContent = d.th.toFixed(0);\
            \}\
\
            if (d.reminder && d.reminder.length > 0) \{\
                document.getElementById('reminderText').textContent = d.reminder;\
                document.getElementById('reminderBox').classList.add('visible');\
            \}\
\
            if (historyData.length > 0 && chartInstance) \{\
                updateChart();\
            \}\
        \}\
\
        // \uc0\u1057 \u1090 \u1072 \u1088 \u1090 \
        connect();\
    </script>\
