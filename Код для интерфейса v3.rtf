        function getProfileValue(field, age, breed) \{\
            const prof = demoProfiles[breed] || demoProfiles[0];\
            if (age <= prof[0][0]) return prof[0][field];\
            if (age >= prof[prof.length-1][0]) return prof[prof.length-1][field];\
            for (let i = 0; i < prof.length-1; i++) \{\
                if (age >= prof[i][0] && age < prof[i+1][0]) \{\
                    const ratio = (age - prof[i][0]) / (prof[i+1][0] - prof[i][0]);\
                    return prof[i][field] + (prof[i+1][field] - prof[i][field]) * ratio;\
                \}\
            \}\
            return prof[prof.length-1][field];\
        \}\
